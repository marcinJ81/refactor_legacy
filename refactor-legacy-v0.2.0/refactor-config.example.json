{
  "wersja_harnessu": "0.2.2",
  "schema": "refactor-legacy/config",
  "schema_version": 2,
  "utworzono": "yyyy-MM-dd; HH-mm-ss",
  "zaktualizowano": "yyyy-MM-dd; HH-mm-ss",

  "projekt": {
    "fragment": "<metoda / klasa / kontroler-moduł objęty refaktorem>",
    "opis": "<jednozdaniowy opis celu przebiegu>"
  },

  "harness": {
    "znacznik_czasu": "yyyy-MM-dd; HH-mm-ss",
    "katalog_wynikowy": "refactor-resultN"
  },

  "tryb": {
    "wartosc": "normalny",
    "zrodlo": "domyslne",
    "_dozwolone": ["normalny"]
  },

  "pytanie_0": {
    "commitowanie": {
      "wartosc": "reczne",
      "zrodlo": "uzytkownik",
      "_dozwolone": ["reczne"]
    },
    "zgoda_build": {
      "wartosc": true,
      "zrodlo": "uzytkownik",
      "_dozwolone": [true, false]
    },
    "zgoda_testy": {
      "wartosc": true,
      "zrodlo": "uzytkownik",
      "_dozwolone": [true, false]
    },
    "wersja_dotnet": {
      "wartosc": "net5plus",
      "zrodlo": "wykryte+potwierdzone",
      "_dozwolone": ["framework", "core", "net5plus"]
    },
    "solucja": {
      "wartosc": "<ścieżka do .sln względem katalogu projektu>",
      "zrodlo": "uzytkownik"
    },
    "sekwencja_budowania": {
      "wartosc": ["<ścieżka do .csproj budowanego jako pierwszy>", "<kolejny .csproj>"],
      "zrodlo": "uzytkownik"
    },
    "projekty_testowe": {
      "wartosc": ["<ścieżka do .csproj projektu testowego>"],
      "zrodlo": "uzytkownik"
    },
    "zmiany_bez_planu": {
      "wartosc": "zabronione",
      "zrodlo": "uzytkownik",
      "_dozwolone": ["zabronione", "dozwolone"]
    },
    "framework_testow": {
      "wartosc": "NUnit",
      "zrodlo": "wykryte+potwierdzone",
      "_dozwolone": ["NUnit", "xUnit", "MSTest", "inny"]
    },
    "granulacja": {
      "wartosc": "dynamiczna",
      "zrodlo": "uzytkownik",
      "_dozwolone": ["automatyczna", "metoda", "klasa", "kontroler-modul", "dynamiczna"],
      "szczegoly": ""
    }
  },

  "pytanie_1": {
    "struktura_plikow": {
      "wartosc": "A",
      "zrodlo": "uzytkownik",
      "_dozwolone": ["A", "B"]
    },
    "plik_szczegolowy_per_iteracja": {
      "wartosc": false,
      "zrodlo": "uzytkownik"
    }
  },

  "pytanie_2": {
    "zakres_etapow": {
      "wartosc": "A",
      "zrodlo": "uzytkownik",
      "_dozwolone": ["A", "B"]
    },
    "pominiete": []
  }
}
